# ---------------------------------------------------------------------------
# CivicAI environment configuration. Copy to .env and edit values.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# Public origin used for same-origin checks (leave blank to derive from Host)
PUBLIC_ORIGIN=

# Database + uploads (created automatically; ignored by git)
DB_PATH=./data/civicai.db
UPLOAD_DIR=./data/uploads

# Secrets. Leave blank in development and a random secret is generated once
# into data/.secret. In production ALWAYS set a strong value.
SESSION_SECRET=
TRACKING_SECRET=

# Bootstrap administrator (only created when the users table is empty).
# Change the password immediately after first login in Settings.
ADMIN_EMAIL=admin@civicai.local
ADMIN_PASSWORD=CivicAI@2026
ADMIN_NAME=City Administrator

# Session lifetime in days
SESSION_TTL_DAYS=7

# Uploads: hard cap enforced by multer; admins can lower the effective limit
# in Settings (live). JPG/JPEG/PNG/WebP only, verified by magic bytes.
MAX_IMAGE_MB=8

# ---------------------------------------------------------------------------
# AI provider (optional). CivicAI works fully without it using a transparent
# local rules engine, which is always labelled as a fallback in the UI.
# Any OpenAI-compatible chat-completions endpoint works.
# ---------------------------------------------------------------------------
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
# Optional vision analysis of uploaded photos (requires a vision-capable model)
AI_IMAGE_ANALYSIS=false
